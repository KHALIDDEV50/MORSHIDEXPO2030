# MORSHID environment — copy to .env.local. No paid keys are required to run the demo.

# Data source:
#   "mock"   — demo repositories only (default)
#   "hybrid" — domains listed in NEXT_PUBLIC_LIVE_DOMAINS use the real API, the rest stay on demo data
#   "http"   — every domain uses the real API (only once the backend implements all contracts)
NEXT_PUBLIC_DATA_SOURCE=hybrid

# Base URL of the MORSHID-Expo2030 Spring Boot API (port 8080 by default), including /api/v1.
# Web on the same machine: http://localhost:8080/api/v1
# Phone/emulator via the Expo wrapper: use your computer's LAN IP (e.g. http://192.168.1.20:8080/api/v1),
# or http://10.0.2.2:8080/api/v1 from the Android emulator. Production: your deployed API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Domains served by the backend in "hybrid" mode (comma-separated): places, expo
# Plans, chat, notifications, auth and subscriptions have no compatible backend yet and stay demo.
NEXT_PUBLIC_LIVE_DOMAINS=places,expo

# Map provider: "maplibre" (default, free, OpenFreeMap tiles) | "google" (future, requires approval + key)
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Optional — only after explicit approval of a paid Google Maps setup (D-023)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
